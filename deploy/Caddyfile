# Auto-TLS (Let's Encrypt) for the stable hostnames. Serves the built dashboard
# (SPA) at / and proxies the API under /v1 to the backend (same origin → no CORS).
# One Caddy fronts BOTH stacks on the shared box (env from /opt/sr/deploy/.env.prod):
#   $DOMAIN     (54-211-23-18.sslip.io) → PROD, project sr     (`backend`, default network)
#   $DOMAIN_DEV (52-5-45-84.sslip.io)   → DEV,  project sr-dev (`backend-dev`, sr-edge network)
{$DOMAIN} {
	encode gzip
	handle /v1/* {
		reverse_proxy backend:8081
	}
	handle {
		root * /srv/dashboard
		try_files {path} /index.html
		file_server
	}
}

{$DOMAIN_DEV} {
	encode gzip
	handle /v1/* {
		reverse_proxy backend-dev:8081
	}
	handle {
		root * /srv/dashboard-dev
		try_files {path} /index.html
		file_server
	}
}
